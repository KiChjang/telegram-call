#!/usr/bin/env python3
"""telegram-call skill: places a 1-on-1 Telegram voice call to a user, plays
an audio file, and hangs up. Uses the standard stdin/stdout JSON skill
protocol for the Octos gateway.

This script is fully self-bootstrapping. After `octos skills install`:

1. On first invocation it creates a private venv at .venv/ inside the skill
   directory, pip-installs pyrogram / pytgcalls / tgcrypto, then re-execs
   itself using that venv's Python. No external `pip install` step is
   needed.
2. Telegram authentication is driven through the chat: when the session is
   missing, the skill returns `success: false` with a clear message asking
   the agent to relay a question to the user (phone, then verification
   code, then optional 2FA password). Each call carries the next piece of
   information back as a parameter. No interactive shell login is needed.

Once authenticated, normal calls only need `target` and `audio_path`.
"""
import asyncio
import hashlib
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.request

SKILL_DIR = os.path.dirname(os.path.realpath(__file__))
VENV_DIR = os.path.join(SKILL_DIR, ".venv")
VENV_PYTHON = os.path.join(VENV_DIR, "bin", "python3")
VENV_PIP = os.path.join(VENV_DIR, "bin", "pip")
REQUIREMENTS = os.path.join(SKILL_DIR, "requirements.txt")
DEPS_MARKER = os.path.join(VENV_DIR, ".deps-installed")
IN_VENV_FLAG = "TELEGRAM_CALL_VENV_BOOTSTRAPPED"


def _emit(success: bool, msg: str) -> None:
    print(json.dumps({"output": msg, "success": success}), flush=True)


def fail(msg: str) -> "None":
    _emit(False, msg)
    sys.exit(1)


def ok(msg: str) -> "None":
    _emit(True, msg)
    sys.exit(0)


def ensure_venv_and_reexec() -> None:
    """First-run bootstrap: create a private venv with required deps, then
    re-exec into it. No-op on subsequent invocations."""
    if os.environ.get(IN_VENV_FLAG):
        return
    try:
        if not os.path.exists(VENV_PYTHON):
            subprocess.check_call(
                [sys.executable, "-m", "venv", VENV_DIR],
                stdout=sys.stderr, stderr=sys.stderr,
            )
        if not os.path.exists(DEPS_MARKER):
            subprocess.check_call(
                [VENV_PIP, "install", "-q", "--disable-pip-version-check",
                 "-r", REQUIREMENTS],
                stdout=sys.stderr, stderr=sys.stderr,
            )
            with open(DEPS_MARKER, "w") as f:
                f.write("ok\n")
    except FileNotFoundError as e:
        fail(
            f"Failed to bootstrap dependencies: {e}. "
            "The system needs a working python3 with the venv module "
            "(on Debian/Ubuntu: `apt install python3-venv`)."
        )
    except subprocess.CalledProcessError as e:
        fail(
            f"Failed to bootstrap dependencies (exit {e.returncode}). "
            "Check the gateway logs for pip output and ensure the gateway "
            "has network access (manifest requires_network is true)."
        )
    env = dict(os.environ, **{IN_VENV_FLAG: "1"})
    os.execvpe(VENV_PYTHON, [VENV_PYTHON, __file__] + sys.argv[1:], env)


# Bootstrap before importing pyrogram / pytgcalls.
ensure_venv_and_reexec()

# ---------------------------------------------------------------------------
# Everything below this line runs inside the venv.
# ---------------------------------------------------------------------------

DATA_DIR = os.environ.get("OCTOS_DATA_DIR") or os.path.expanduser("~/.octos")
WORK_DIR = os.environ.get("OCTOS_WORK_DIR") or DATA_DIR
SESSION_DIR = os.path.join(DATA_DIR, "telegram-call")
SESSION_NAME = "telegram-call"
SESSION_FILE = os.path.join(SESSION_DIR, f"{SESSION_NAME}.session")
SESSION_JOURNAL = os.path.join(SESSION_DIR, f"{SESSION_NAME}.session-journal")
AUTH_STATE_FILE = os.path.join(SESSION_DIR, "auth_state.json")
# pyrogram creates the .session file as soon as it connects (before sign-in),
# so we use a separate marker that's only written after successful auth.
AUTH_COMPLETE_MARKER = os.path.join(SESSION_DIR, "auth_complete")
# Counts consecutive PHONE_CODE_EXPIRED responses across send_code restarts.
# Persisted separately from AUTH_STATE_FILE so it survives clear_auth_state().
EXPIRED_COUNTER_FILE = os.path.join(SESSION_DIR, "expired_streak.json")
DEBUG_LOG_FILE = os.path.join(SESSION_DIR, "debug.log")
TTS_DIR = os.path.join(WORK_DIR, "telegram-call-tts")

DEFAULT_KOKORO_URL = "http://localhost:8880"
DEFAULT_KOKORO_VOICE = "af_heart"


def _import_pyrogram():
    """Lazy-import pyrogram and pytgcalls. Only the make_call path needs
    them, so we keep them out of the synthesize_speech hot path."""
    # Pyrogram's `sync.py` calls `asyncio.get_event_loop()` at import time. In
    # Python 3.10+ that emits a DeprecationWarning when no loop is set, and in
    # 3.12+ it raises RuntimeError. Pre-set a loop so the import succeeds.
    try:
        asyncio.get_event_loop()
    except RuntimeError:
        asyncio.set_event_loop(asyncio.new_event_loop())
    import pyrogram  # noqa: F401
    from pyrogram import Client
    from pyrogram import errors as pyrogram_errors
    from pytgcalls import PyTgCalls
    from pytgcalls import filters as fl
    from pytgcalls.types import CallConfig, ChatUpdate, MediaStream
    return {
        "Client": Client,
        "errors": pyrogram_errors,
        "PyTgCalls": PyTgCalls,
        "fl": fl,
        "CallConfig": CallConfig,
        "ChatUpdate": ChatUpdate,
        "MediaStream": MediaStream,
    }


def get_creds():
    api_id_str = os.environ.get("TELEGRAM_API_ID", "").strip()
    api_hash = os.environ.get("TELEGRAM_API_HASH", "").strip()
    if not api_id_str or not api_hash:
        fail(
            "TELEGRAM_API_ID and TELEGRAM_API_HASH environment variables must "
            "be set. Get a free API ID/hash from https://my.telegram.org/apps "
            "and add them to your Octos profile, then retry."
        )
    try:
        return int(api_id_str), api_hash
    except ValueError:
        fail(f"TELEGRAM_API_ID must be an integer, got {api_id_str!r}")


def load_auth_state() -> dict:
    try:
        with open(AUTH_STATE_FILE) as f:
            return json.load(f)
    except FileNotFoundError:
        return {}
    except json.JSONDecodeError:
        return {}


def save_auth_state(state: dict) -> None:
    tmp = AUTH_STATE_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f)
    os.replace(tmp, AUTH_STATE_FILE)


def clear_auth_state() -> None:
    try:
        os.remove(AUTH_STATE_FILE)
    except FileNotFoundError:
        pass


def auth_complete() -> bool:
    return os.path.isfile(AUTH_COMPLETE_MARKER)


def mark_auth_complete() -> None:
    with open(AUTH_COMPLETE_MARKER, "w") as f:
        f.write("ok\n")
    # Successful auth invalidates any prior expired-code streak.
    _reset_expired_streak()


def _read_expired_streak() -> int:
    try:
        with open(EXPIRED_COUNTER_FILE) as f:
            return int(json.load(f).get("count") or 0)
    except (FileNotFoundError, ValueError, json.JSONDecodeError):
        return 0


def _write_expired_streak(count: int) -> None:
    try:
        os.makedirs(SESSION_DIR, exist_ok=True)
        tmp = EXPIRED_COUNTER_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump({"count": int(count), "updated_at": int(time.time())}, f)
        os.replace(tmp, EXPIRED_COUNTER_FILE)
    except OSError:
        pass


def _reset_expired_streak() -> None:
    try:
        os.remove(EXPIRED_COUNTER_FILE)
    except FileNotFoundError:
        pass


def purge_session_files() -> dict:
    """Nuke every auth artifact: auth_state.json, auth_complete marker, the
    pyrogram .session file (and -journal), and the expired-streak counter.
    Returns a dict describing which files were removed for surfacing back to
    the agent."""
    removed = []
    not_present = []
    for path in (AUTH_STATE_FILE, AUTH_COMPLETE_MARKER, SESSION_FILE,
                 SESSION_JOURNAL, EXPIRED_COUNTER_FILE):
        if os.path.exists(path):
            try:
                os.remove(path)
                removed.append(os.path.basename(path))
            except OSError as e:
                removed.append(f"{os.path.basename(path)} (error: {e})")
        else:
            not_present.append(os.path.basename(path))
    return {"removed": removed, "not_present": not_present}


def _debug_log(msg: str) -> None:
    """Append a line to debug.log when TELEGRAM_CALL_DEBUG is set. The log is
    safe to keep around (no secrets — just truncated hashes / DC ids)."""
    if not os.environ.get("TELEGRAM_CALL_DEBUG"):
        return
    try:
        os.makedirs(SESSION_DIR, exist_ok=True)
        with open(DEBUG_LOG_FILE, "a") as f:
            f.write(f"[{time.strftime('%Y-%m-%dT%H:%M:%S')}] [{os.getpid()}] {msg}\n")
    except OSError:
        pass


async def _client_diag(app) -> str:
    """Return a short string describing the connected client's session state,
    for use in debug logs and error surfaces. Truncates anything sensitive."""
    try:
        dc_id = await app.storage.dc_id()
    except Exception:
        dc_id = "?"
    try:
        tm = await app.storage.test_mode()
    except Exception:
        tm = "?"
    try:
        ak = await app.storage.auth_key()
        ak_prefix = ak.hex()[:8] if ak else "<none>"
    except Exception:
        ak_prefix = "?"
    return f"dc={dc_id} test_mode={tm} auth_key_prefix={ak_prefix}"


def _read_session_main_file() -> str:
    """Read the .session file directly (bypassing pyrogram) to see what is
    actually persisted on disk. Returns a one-line summary suitable for
    debug logging. Used to distinguish 'pyrogram didn't persist' from
    'pyrogram persisted but ignored on next load'."""
    if not os.path.isfile(SESSION_FILE):
        return "session_file=missing"
    try:
        import sqlite3
        size = os.path.getsize(SESSION_FILE)
        conn = sqlite3.connect(f"file:{SESSION_FILE}?mode=ro", uri=True, timeout=1)
        try:
            row = conn.execute(
                "SELECT test_mode, hex(substr(auth_key, 1, 4)) FROM sessions"
            ).fetchone()
        finally:
            conn.close()
        if row is None:
            return f"session_file={size}b sessions_table=empty"
        tm, ak_hex = row
        return (
            f"session_file={size}b on_disk_test_mode={tm} "
            f"on_disk_auth_key_prefix={ak_hex.lower() if ak_hex else None!r}"
        )
    except Exception as e:
        return f"session_file_read_error={type(e).__name__}: {e}"


async def _pin_partial_session(app) -> None:
    """Mark the storage as 'non-empty' so pyrogram reuses its auth_key on the
    next process invocation, even if the user hasn't completed sign-in yet.

    Pyrogram's `Client.load_session()` (in client.py) decides whether to do
    a fresh Diffie-Hellman handshake based on:

        session_empty = any([
            await self.storage.test_mode() is None,
            await self.storage.auth_key() is None,
            await self.storage.user_id() is None,
            await self.storage.is_bot() is None,
        ])

    `user_id` and `is_bot` are only populated when `auth.signIn` succeeds.
    Since the Octos skill protocol is stateless across tool calls, the
    auth flow always spans at least two processes (one to send the code,
    one to verify it). Without pinning, the verifier process re-runs DH,
    rotates auth_key, and orphans the phone_code_hash from the sender —
    Telegram then returns PHONE_CODE_EXPIRED even on a freshly-issued
    code that the user typed in correctly within seconds.

    Stamping placeholder values keeps `session_empty == False`, so the
    auth_key (and therefore the phone_code_hash binding) survives across
    processes. Real values get written by `sign_in` / `check_password`
    later (sign_in.py line 77+ overwrites `user_id` with the actual user
    id and `is_bot` with the real flag), so this stamping is harmless.
    """
    try:
        if await app.storage.user_id() is None:
            await app.storage.user_id(0)
        if await app.storage.is_bot() is None:
            await app.storage.is_bot(False)
    except Exception as e:
        _debug_log(f"pin_partial_session failed: {type(e).__name__}: {e}")


async def _auth_client():
    """Build and connect a pyrogram Client for the auth steps. Returns the
    connected client and the lazy-imported pyrogram bundle.

    Pins the storage with placeholder `user_id` / `is_bot` immediately
    after connect so the auth_key persists across processes (see
    `_pin_partial_session` for the gory detail)."""
    pg = _import_pyrogram()
    api_id, api_hash = get_creds()
    _debug_log(f"pre-connect on-disk: {_read_session_main_file()}")
    app = pg["Client"](
        SESSION_NAME, api_id=api_id, api_hash=api_hash, workdir=SESSION_DIR,
    )
    await app.connect()
    _debug_log(f"post-connect in-memory: {await _client_diag(app)}")
    await _pin_partial_session(app)
    return app, pg


async def _disconnect(app) -> None:
    """Tear down a pyrogram client. Logs pre- and post-disconnect snapshots
    of the session state when `TELEGRAM_CALL_DEBUG` is enabled, so any
    auth_key drift across processes is easy to spot in `debug.log`."""
    pre_state = ""
    try:
        pre_state = await _client_diag(app)
    except Exception:
        pass
    try:
        await app.disconnect()
    except Exception as e:
        _debug_log(f"disconnect failed: {type(e).__name__}: {e}")
    if pre_state:
        _debug_log(f"pre-disconnect in-memory: {pre_state}")
    _debug_log(f"post-disconnect on-disk: {_read_session_main_file()}")


_SENT_CODE_LABELS = {
    "APP": "an in-app Telegram message (from the official 'Telegram' "
           "service-account chat to the user's existing logged-in sessions)",
    "SMS": "SMS",
    "CALL": "an automated voice call (a Telegram robot will phone the user "
            "and read the 5-digit code aloud)",
    "FLASH_CALL": "a flash call (the code is the last digits of the "
                  "incoming caller ID)",
    "MISSED_CALL": "a missed call (the code is the last digits of the "
                   "missed-call number)",
    "EMAIL_CODE": "email",
    "FRAGMENT_SMS": "Fragment SMS (anonymous number)",
    "FIREBASE_SMS": "SMS (via Firebase)",
}


def _sent_code_label(t) -> str:
    """Human-readable description of a Pyrogram `SentCodeType` value."""
    if t is None:
        return "an unspecified channel"
    name = getattr(t, "name", str(t)).upper()
    return _SENT_CODE_LABELS.get(name, name.lower().replace("_", " "))


def _flood_wait_seconds(exc) -> int:
    """Pull the wait-seconds out of a pyrogram FloodWait, tolerating both
    the 2.x `.value` attribute and the older `.x` attribute."""
    for attr in ("value", "x"):
        v = getattr(exc, attr, None)
        if isinstance(v, int) and v >= 0:
            return v
    try:
        return int(str(exc).split()[-1])
    except Exception:
        return 0


def _humanize_seconds(s: int) -> str:
    if s < 60:
        return f"{s}s"
    if s < 3600:
        return f"{s // 60}m {s % 60}s"
    h, rem = divmod(s, 3600)
    return f"{h}h {rem // 60}m"


def _build_code_sent_message(phone: str, sent, action: str = "issued") -> str:
    """Format the message returned to the agent after a successful
    send_code / resend_code, telling it where Telegram routed the code."""
    sent_label = _sent_code_label(getattr(sent, "type", None))
    next_label = _sent_code_label(getattr(sent, "next_type", None)) \
        if getattr(sent, "next_type", None) is not None else None
    timeout = getattr(sent, "timeout", None) or 0

    msg = (
        f"Telegram has {action} a verification code for {phone} (the user's "
        f"OWN Telegram account, NOT the recipient). It says the code was "
        f"delivered via {sent_label}. "
    )
    msg += (
        "Tell the user where to look (in-app chat, SMS, or incoming call as "
        "appropriate), then pass the 5-digit code to the "
        "`verify_telegram_code` tool as the `code` parameter. "
    )
    if next_label:
        wait_hint = (
            f" (Telegram allows another resend in ~{timeout}s.)"
            if timeout else ""
        )
        msg += (
            f"IF the code never arrives, the agent should call "
            f"`verify_telegram_code` with `resend: true` to escalate "
            f"delivery to {next_label}.{wait_hint} "
        )
    msg += (
        "Do NOT call `make_call` again with `phone` — that would invalidate "
        "the code that was just issued."
    )
    return msg


async def send_phone_code(phone: str) -> None:
    """Step 1 of auth: ask Telegram to send a verification code to the user's
    phone, persist the resulting `phone_code_hash`, and exit with a message
    telling the agent to invoke `verify_telegram_code` next.

    Always exits via fail() (since this step never completes auth on its own)
    or success-then-exit; never returns normally."""
    streak = _read_expired_streak()
    if streak >= 2:
        fail(
            f"Refusing to issue another verification code: Telegram has "
            f"rejected {streak} consecutive freshly-issued codes as expired, "
            "which means the local pyrogram session is desynchronised and a "
            "new code WILL be invalidated the same way. The agent must call "
            "`reset_telegram_auth` to wipe the local session, THEN call "
            "`make_call` with the user's `phone` again. (Issuing yet "
            "another code without resetting first will not help and risks "
            "Telegram flood-limiting the number.)"
        )
    app, pg = await _auth_client()
    errors = pg["errors"]
    try:
        try:
            sent = await app.send_code(phone)
        except errors.PhoneNumberInvalid:
            fail(
                f"Telegram says {phone!r} is not a valid phone number. Ask "
                "the user to double-check and provide a fresh `phone` "
                "(must include the country code, e.g. +44…)."
            )
        except errors.PhoneNumberBanned:
            fail(
                f"Telegram has banned the phone number {phone}. The user "
                "must contact Telegram support to lift the ban; this skill "
                "cannot work around it."
            )
        except errors.PhoneNumberFlood:
            fail(
                f"Telegram has temporarily blocked new login codes for "
                f"{phone} because too many have been requested recently. "
                "Wait at least 24 hours before trying this number again, "
                "or use a different Telegram account."
            )
        except errors.FloodWait as e:
            wait = _flood_wait_seconds(e)
            fail(
                f"Telegram is rate-limiting login-code requests for {phone}. "
                f"Wait {_humanize_seconds(wait)} ({wait}s) and call "
                "`make_call` with the same `phone` again. Telegram will "
                "ignore further `send_code` calls until that window expires "
                "— so the code the user sees might still arrive from the "
                "*previous* attempt; if so, use `verify_telegram_code` with "
                "that code instead of asking for a fresh one."
            )
        except errors.BadRequest as e:
            fail(f"Telegram rejected the phone number: {e}")
        save_auth_state({
            "awaiting": "code",
            "phone": phone,
            "phone_code_hash": sent.phone_code_hash,
            "sent_type": getattr(getattr(sent, "type", None), "name", None),
            "next_type": getattr(getattr(sent, "next_type", None), "name", None),
            "code_issued_at": int(time.time()),
        })
        _debug_log(
            f"send_code OK phone={phone} hash_prefix={sent.phone_code_hash[:8]!r} "
            f"type={getattr(getattr(sent, 'type', None), 'name', None)!r}"
        )
        fail(_build_code_sent_message(phone, sent, action="issued"))
    finally:
        await _disconnect(app)


async def resend_phone_code() -> None:
    """Ask Telegram to redeliver the current verification code via the next
    channel (typically APP → SMS → CALL). Reuses the persisted
    `phone_code_hash` and updates state with whatever Telegram returns."""
    state = load_auth_state()
    if state.get("awaiting") != "code":
        fail(
            "No verification code is currently being awaited, so there is "
            "nothing to resend. Start the auth flow by calling `make_call` "
            "with the user's `phone` first."
        )
    phone = state.get("phone")
    phone_code_hash = state.get("phone_code_hash")
    if not phone or not phone_code_hash:
        clear_auth_state()
        fail(
            "Lost track of the in-flight verification code. Call `make_call` "
            "with the user's `phone` to start the auth flow again."
        )

    app, pg = await _auth_client()
    errors = pg["errors"]
    try:
        try:
            sent = await app.resend_code(phone, phone_code_hash)
        except errors.PhoneCodeExpired:
            clear_auth_state()
            streak = _read_expired_streak() + 1
            _write_expired_streak(streak)
            _debug_log(f"resend PHONE_CODE_EXPIRED streak={streak}")
            base = (
                "The previous verification code has already expired, so "
                "Telegram won't resend it. "
            )
            if streak >= 2:
                fail(
                    base + "This is the "
                    f"{streak}{'nd' if streak == 2 else 'rd' if streak == 3 else 'th'} "
                    "consecutive time Telegram has rejected a freshly-issued "
                    "code as expired, which means the local Telegram session "
                    "(`telegram-call.session`) holds a stale `auth_key` — most "
                    "likely created by an older buggy version of this skill. "
                    "Call the `reset_telegram_auth` tool to wipe all auth "
                    "artifacts (session file, auth_state, expired-streak "
                    "counter) and start fresh. After that, call `make_call` "
                    "with the user's `phone` to begin a clean authentication."
                )
            fail(
                base + "Call `make_call` with the user's `phone` to restart "
                "the auth flow with a fresh code. If this happens again on "
                "the next attempt, call `reset_telegram_auth` to fully wipe "
                "the local Telegram session before retrying."
            )
        except errors.FloodWait as e:
            wait = _flood_wait_seconds(e)
            fail(
                f"Telegram is rate-limiting resend requests for {phone}. "
                f"Wait {_humanize_seconds(wait)} ({wait}s) before calling "
                "`verify_telegram_code` with `resend: true` again."
            )
        except errors.RPCError as e:
            fail(
                f"Telegram rejected the resend request: {type(e).__name__}: "
                f"{e}. The auth state has been preserved; the user can "
                "still submit any code they may have already received via "
                "`verify_telegram_code` with `code`."
            )

        save_auth_state({
            "awaiting": "code",
            "phone": phone,
            "phone_code_hash": sent.phone_code_hash,
            "sent_type": getattr(getattr(sent, "type", None), "name", None),
            "next_type": getattr(getattr(sent, "next_type", None), "name", None),
            "code_issued_at": int(time.time()),
        })
        msg = _build_code_sent_message(phone, sent, action="resent")
        msg += (
            " Note: any previously-issued code for this login is now "
            "invalid — only accept the freshly-arriving one."
        )
        fail(msg)
    finally:
        await _disconnect(app)


async def verify_phone_code(code: str) -> None:
    """Step 2 of auth: submit the verification code. Returns normally on
    success (state cleared, auth marker written); calls fail() otherwise.

    Critically, on PhoneCodeInvalid (a typo / wrong code) we KEEP the auth
    state so the agent can retry with a fresh code — clearing it would force
    a new send_code, invalidating the code the user already received."""
    state = load_auth_state()
    if state.get("awaiting") != "code":
        fail(
            "No verification code is currently being awaited. Start the auth "
            "flow by calling `make_call` with the user's `phone` first."
        )

    issued_at = state.get("code_issued_at") or 0
    elapsed = (int(time.time()) - issued_at) if issued_at else None
    elapsed_str = (
        f"~{_humanize_seconds(elapsed)} ({elapsed}s)" if elapsed is not None
        else "an unknown duration"
    )
    hash_prefix = (state.get("phone_code_hash") or "")[:8]
    sent_label = _SENT_CODE_LABELS.get(
        state.get("sent_type") or "", "an in-app Telegram message"
    )
    next_label = _SENT_CODE_LABELS.get(state.get("next_type") or "", None)

    app, pg = await _auth_client()
    errors = pg["errors"]
    try:
        try:
            signed = await app.sign_in(
                state["phone"], state["phone_code_hash"], code,
            )
            if signed is not None:
                clear_auth_state()
                mark_auth_complete()
                return
            # signed == None typically means TermsOfService accepted; treat as success.
            clear_auth_state()
            mark_auth_complete()
            return
        except errors.SessionPasswordNeeded:
            state["awaiting"] = "password"
            save_auth_state(state)
            fail(
                "Telegram has 2FA enabled on this account. Ask the user "
                "for their cloud password and pass it to the "
                "`verify_telegram_code` tool as the `password` parameter."
            )
        except errors.PhoneCodeInvalid:
            # KEEP state — the user just typed the wrong digits. Asking for
            # the phone again would trigger a new send_code and invalidate
            # the code that was actually sent.
            fail(
                f"Telegram rejected the code {code!r} as invalid (typo "
                f"or wrong code). The code was issued {elapsed_str} ago "
                f"via {sent_label} (hash prefix {hash_prefix!r}). The "
                "auth state is preserved — ask the user to read the code "
                "off their Telegram app again and call `verify_telegram_code` "
                "with the correct `code`. Do NOT restart the auth flow."
            )
        except errors.PhoneCodeExpired:
            # KEEP auth_state (the phone_code_hash may still work for resend),
            # but bump the consecutive-expiration streak so we can detect the
            # session-corruption loop where every fresh code is rejected.
            streak = _read_expired_streak() + 1
            _write_expired_streak(streak)
            _debug_log(
                f"sign_in PHONE_CODE_EXPIRED streak={streak} elapsed={elapsed} "
                f"hash_prefix={hash_prefix!r}"
            )
            msg = (
                f"Telegram says the verification code has expired "
                f"(PHONE_CODE_EXPIRED). It was issued {elapsed_str} ago via "
                f"{sent_label} (hash prefix {hash_prefix!r}). "
            )
            if streak >= 2:
                msg += (
                    f"This is the {streak}{'nd' if streak == 2 else 'rd' if streak == 3 else 'th'} "
                    "consecutive time a fresh code has been rejected as "
                    "expired — the locally-stored Telegram session "
                    "(`telegram-call.session`) holds a stale `auth_key` "
                    "(most likely created by an older buggy version of this "
                    "skill). RECOVERY: call the `reset_telegram_auth` tool "
                    "to wipe all auth artifacts and start fresh, then "
                    "`make_call` with the user's `phone` to restart auth."
                )
                fail(msg)
            if elapsed is not None and elapsed < 60:
                msg += (
                    "Since this was less than a minute ago, the most likely "
                    "explanations are: (a) the user submitted an EARLIER "
                    "code from a previous attempt (ask them to read the "
                    "*most recent* 5-digit code in their Telegram app), or "
                    "(b) the local Telegram session is corrupted and "
                    "Telegram is invalidating codes on issuance. "
                )
            else:
                msg += (
                    "Telegram codes are valid for only a few minutes; this "
                    "one has aged out. "
                )
            msg += (
                "RECOVERY: call `verify_telegram_code` with `resend: true` "
                "to ask Telegram to issue a fresh code"
            )
            if next_label:
                msg += f" (next channel: {next_label})"
            msg += (
                ". If resend also fails, call `reset_telegram_auth` to wipe "
                "the local session and restart cleanly."
            )
            fail(msg)
        except errors.FloodWait as e:
            wait = _flood_wait_seconds(e)
            fail(
                f"Telegram is rate-limiting sign-in attempts. Wait "
                f"{_humanize_seconds(wait)} ({wait}s) before calling "
                "`verify_telegram_code` again."
            )
        except errors.RPCError as e:
            fail(
                f"Telegram rejected the verification: {type(e).__name__}: "
                f"{e}. Code was issued {elapsed_str} ago via {sent_label} "
                f"(hash prefix {hash_prefix!r}). Auth state has been "
                "preserved. If this is unexpected, see SKILL.md for how to "
                "fully reset auth state."
            )
    finally:
        await _disconnect(app)


async def verify_2fa_password(password: str) -> None:
    """Step 3 of auth (only when 2FA is enabled): submit the cloud password.
    Returns normally on success; calls fail() otherwise. Wrong-password
    keeps state so the user can retry."""
    state = load_auth_state()
    if state.get("awaiting") != "password":
        fail(
            "No 2FA password is currently being awaited. Either no auth is "
            "in progress, or the previous step expected a `code` instead. "
            "Start with `make_call` and `phone`, then `verify_telegram_code`."
        )

    app, pg = await _auth_client()
    errors = pg["errors"]
    try:
        try:
            await app.check_password(password)
            clear_auth_state()
            mark_auth_complete()
            return
        except errors.PasswordHashInvalid:
            # KEEP state so the user can retry the password.
            fail(
                "Telegram rejected the 2FA password as incorrect. Ask the "
                "user to try again and call `verify_telegram_code` with a "
                "fresh `password`."
            )
    finally:
        await _disconnect(app)


async def make_call_flow(target: str, audio_path: str, message: str) -> None:
    pg = _import_pyrogram()
    Client = pg["Client"]
    errors = pg["errors"]
    PyTgCalls = pg["PyTgCalls"]
    fl = pg["fl"]
    CallConfig = pg["CallConfig"]
    ChatUpdate = pg["ChatUpdate"]
    MediaStream = pg["MediaStream"]

    api_id, api_hash = get_creds()
    if not os.path.isfile(audio_path):
        fail(f"Audio file not found: {audio_path}")

    ring_timeout = int(os.environ.get("TELEGRAM_CALL_RING_TIMEOUT", "30"))
    max_duration = float(os.environ.get("TELEGRAM_CALL_MAX_DURATION", "90"))

    app = Client(
        SESSION_NAME, api_id=api_id, api_hash=api_hash, workdir=SESSION_DIR,
        no_updates=False,
    )
    tgcalls = PyTgCalls(app)
    call_ended = asyncio.Event()
    end_reason = {"value": "completed"}

    @tgcalls.on_update(fl.stream_end())
    async def _on_stream_end(_, __):
        end_reason["value"] = "stream_finished"
        call_ended.set()

    @tgcalls.on_update(fl.chat_update(ChatUpdate.Status.LEFT_CALL))
    async def _on_left(_, update):
        status = update.status
        if status & ChatUpdate.Status.BUSY_CALL:
            end_reason["value"] = "busy"
        elif status & ChatUpdate.Status.DISCARDED_CALL:
            end_reason["value"] = "discarded"
        elif end_reason["value"] == "completed":
            end_reason["value"] = "left"
        call_ended.set()

    user_id = None
    started_app = False
    started_calls = False
    try:
        await app.start()
        started_app = True
        await tgcalls.start()
        started_calls = True

        try:
            user = await app.get_users(target)
        except errors.RPCError as e:
            fail(
                f"Could not resolve target {target!r}: {e}. Phone numbers "
                "only work if the user is in your contacts; prefer @username "
                "or numeric user_id."
            )
        user_id = user.id

        try:
            await tgcalls.play(
                user_id,
                MediaStream(audio_path, video_flags=MediaStream.Flags.IGNORE),
                config=CallConfig(timeout=ring_timeout),
            )
        except FileNotFoundError as e:
            fail(f"ffmpeg could not read audio file {audio_path!r}: {e}")
        except Exception as e:
            fail(f"Failed to start call to {target!r}: {type(e).__name__}: {e}")

        try:
            await asyncio.wait_for(call_ended.wait(), timeout=max_duration)
        except asyncio.TimeoutError:
            end_reason["value"] = "max_duration_exceeded"

        descriptor = message or audio_path
        reason = end_reason["value"]
        if reason in ("stream_finished", "left", "completed"):
            ok(f"Call completed ({reason}): {descriptor}")
        elif reason == "busy":
            fail(f"Call to {target!r} was busy: {descriptor}")
        elif reason == "discarded":
            fail(f"Call to {target!r} was declined or not answered: {descriptor}")
        else:
            ok(f"Call hung up after {max_duration}s ({reason}): {descriptor}")
    finally:
        if started_calls and user_id is not None:
            try:
                await tgcalls.leave_call(user_id)
            except Exception:
                pass
        if started_app:
            try:
                await app.stop()
            except Exception:
                pass


def synthesize_speech_tool(input_data: dict) -> None:
    """POST to a Kokoro-FastAPI server (OpenAI-compatible /v1/audio/speech),
    save the resulting mp3 under $OCTOS_WORK_DIR/telegram-call-tts/, and
    return the path so the agent can chain it into make_call."""
    text = (input_data.get("text") or "").strip()
    if not text:
        fail(
            "Missing 'text' parameter. Pass the spoken message you want to "
            "synthesize as `text` (e.g. 'Hi Alice, this is an automated "
            "alert: there may be a gas leak in your house, please check.')."
        )
    if len(text) > 4000:
        fail(
            f"`text` is {len(text)} characters; please keep messages under "
            "4000 characters per call."
        )

    voice = (input_data.get("voice")
             or os.environ.get("KOKORO_VOICE", DEFAULT_KOKORO_VOICE)).strip()
    try:
        speed = float(input_data.get("speed")
                      or os.environ.get("KOKORO_SPEED", "1.0"))
    except (TypeError, ValueError):
        fail(f"`speed` must be a number, got {input_data.get('speed')!r}")

    kokoro_url = os.environ.get("KOKORO_URL", DEFAULT_KOKORO_URL).rstrip("/")
    timeout = float(os.environ.get("KOKORO_TIMEOUT", "120"))

    os.makedirs(TTS_DIR, exist_ok=True)
    cache_key = hashlib.sha256(
        f"{voice}|{speed}|{text}".encode("utf-8")
    ).hexdigest()[:16]
    out_path = os.path.join(TTS_DIR, f"{cache_key}.mp3")

    if os.path.isfile(out_path) and os.path.getsize(out_path) > 0:
        ok(
            f"Reusing cached TTS audio at {out_path} "
            f"({os.path.getsize(out_path)} bytes). "
            f"Now call `make_call` with audio_path={out_path!r} to play it."
        )

    body = json.dumps({
        "model": "kokoro",
        "input": text,
        "voice": voice,
        "speed": speed,
        "response_format": "mp3",
    }).encode("utf-8")
    req = urllib.request.Request(
        f"{kokoro_url}/v1/audio/speech",
        data=body,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            audio = resp.read()
    except urllib.error.HTTPError as e:
        try:
            detail = e.read().decode("utf-8", "replace")[:500]
        except Exception:
            detail = ""
        fail(
            f"Kokoro-FastAPI returned HTTP {e.code} from {kokoro_url}: "
            f"{detail or e.reason}"
        )
    except urllib.error.URLError as e:
        fail(
            f"Could not reach Kokoro-FastAPI at {kokoro_url}: {e.reason}. "
            "Make sure the Kokoro server is running on localhost:8880 (or "
            "set the KOKORO_URL environment variable)."
        )
    except TimeoutError:
        fail(
            f"Kokoro-FastAPI at {kokoro_url} did not respond within "
            f"{timeout}s. Increase KOKORO_TIMEOUT or check the server."
        )

    if not audio:
        fail(f"Kokoro-FastAPI at {kokoro_url} returned an empty response.")

    tmp = out_path + ".tmp"
    with open(tmp, "wb") as f:
        f.write(audio)
    os.replace(tmp, out_path)

    ok(
        f"Generated TTS audio at {out_path} ({len(audio)} bytes). "
        f"Now call `make_call` with audio_path={out_path!r} to play it."
    )


def _phone_digits(s: str) -> str:
    """Return only the digits of a phone-number-ish string, so '+44 7700 900000',
    '+447700900000', and '00447700900000' all compare equal."""
    digits = "".join(c for c in (s or "") if c.isdigit())
    return digits.lstrip("0")


async def amain_make_call(input_data: dict) -> None:
    phone = (input_data.get("phone") or "").strip()
    target = (input_data.get("target") or "").strip()
    audio_path = input_data.get("audio_path", "")
    message = input_data.get("message", "")
    state = load_auth_state()
    awaiting = state.get("awaiting")

    # Guard against the LLM copying `target` into `phone`. The two parameters
    # represent different people: `phone` is the caller's own Telegram account
    # (only used during one-time login) and `target` is the recipient.
    # Sending a Telegram login code to the recipient's number would be both
    # privacy-violating and useless.
    phone_digits = _phone_digits(phone)
    target_digits = _phone_digits(target)
    if phone_digits and target_digits and phone_digits == target_digits:
        fail(
            f"Refusing to authenticate: the supplied `phone` ({phone}) is "
            f"the same number as `target` ({target}). These MUST be "
            "different people. `phone` is the user's OWN Telegram account "
            "(the one PLACING the call); `target` is the RECIPIENT being "
            "called. Do not copy `target` into `phone`. Ask the user "
            "explicitly: 'What is the phone number of YOUR own Telegram "
            "account (the one that will be placing this call)?' — and call "
            "`make_call` again with that number as `phone`, leaving "
            "`target` unchanged."
        )

    if not auth_complete():
        if awaiting == "code":
            # Escape hatch: if the agent is supplying a *different* phone
            # than the one currently being verified, the user wants to
            # switch to a different Telegram account. Tear down state and
            # restart with the new phone.
            if phone and _phone_digits(phone) and \
                    _phone_digits(phone) != _phone_digits(state.get("phone", "")):
                clear_auth_state()
                await send_phone_code(phone)
                return
            sent_label = _SENT_CODE_LABELS.get(
                state.get("sent_type") or "", "an in-app Telegram message"
            )
            next_label = _SENT_CODE_LABELS.get(state.get("next_type") or "", None)
            issued_at = state.get("code_issued_at") or 0
            age = int(time.time()) - issued_at if issued_at else None
            age_hint = (
                f" (issued ~{_humanize_seconds(age)} ago)"
                if age is not None else ""
            )
            msg = (
                f"Telegram is awaiting the verification code that was sent "
                f"to {state['phone']} (the user's OWN Telegram account, "
                f"which is being authenticated) via {sent_label}{age_hint}. "
                "Ask the user for the code and call the `verify_telegram_code` "
                "tool with it as `code`. Do NOT call `make_call` again "
                "until verification succeeds — calling it with `phone` "
                "would invalidate the code."
            )
            if next_label:
                msg += (
                    f" If the user says they never received a code, call "
                    f"`verify_telegram_code` with `resend: true` to make "
                    f"Telegram redeliver via {next_label}."
                )
            fail(msg)
        if awaiting == "password":
            fail(
                "Telegram is awaiting the user's 2FA cloud password. Ask "
                "the user for it and call the `verify_telegram_code` tool "
                "with it as `password`. Do NOT call `make_call` again "
                "until verification succeeds."
            )
        if phone:
            await send_phone_code(phone)
            # send_phone_code always exits via fail() with instructions.
            return
        target_hint = (
            f" (For clarity: `target` is currently {target!r}, which is the "
            "RECIPIENT — do NOT use that number as `phone`.)"
            if target else ""
        )
        fail(
            "Telegram is not authenticated yet. The skill needs to log in "
            "to the user's OWN Telegram account before it can place any "
            "calls. Ask the user a direct question — verbatim or close to "
            "it — like: 'What's the phone number of YOUR personal Telegram "
            "account? (Not the person you want to call — your own.)' "
            "It must include the international country code, e.g. "
            "'+447700900000'. Then call `make_call` again with `phone` set "
            "to that value." + target_hint + " Telegram will deliver a "
            "5-digit verification code to the user's existing Telegram "
            "sessions (an in-app message from the official 'Telegram' "
            "service account) before falling back to SMS. After Telegram "
            "issues the code, the agent must call `verify_telegram_code` "
            "with the `code` parameter — NOT `make_call` again."
        )

    if not target:
        fail(
            "Missing 'target' parameter. Ask the user who to call on Telegram "
            "and pass it as 'target' on the next call. Accepted forms: "
            "@username, numeric user_id, or +phone_number (phone numbers only "
            "work if the user is already in your contacts)."
        )
    if not audio_path:
        fail(
            "Missing 'audio_path' parameter. If the user wants to convey a "
            "spoken message rather than a pre-recorded file, first call the "
            "`synthesize_speech` tool with the text — it will return a path "
            "you can pass back here as `audio_path`."
        )

    await make_call_flow(target, audio_path, message)


async def amain_verify(input_data: dict) -> None:
    """Handler for the `verify_telegram_code` tool. Decides between phone
    code and 2FA password based on the persisted auth state."""
    if auth_complete():
        ok(
            "Telegram is already authenticated; nothing to verify. You can "
            "call `make_call` directly."
        )
        return

    state = load_auth_state()
    awaiting = state.get("awaiting")
    code = (input_data.get("code")
            or input_data.get("verification_code")
            or "").strip()
    password = (input_data.get("password") or "").strip()
    resend = bool(input_data.get("resend"))

    if resend:
        if awaiting != "code":
            fail(
                "Nothing to resend: no verification code is currently in "
                "flight. Start the auth flow with `make_call` and `phone`."
            )
        await resend_phone_code()
        return

    if awaiting == "code":
        if not code:
            sent_label = _SENT_CODE_LABELS.get(
                state.get("sent_type") or "", "an in-app Telegram message"
            )
            next_label = _SENT_CODE_LABELS.get(state.get("next_type") or "", None)
            msg = (
                f"A verification code was sent for the Telegram account "
                f"{state.get('phone')!r} (the account that will place the "
                f"call) via {sent_label}. Tell the user where to look and "
                "pass the 5-digit code to this tool as the `code` parameter."
            )
            if next_label:
                msg += (
                    f" If the user genuinely did not receive a code, call "
                    f"this tool with `resend: true` to ask Telegram to "
                    f"redeliver via {next_label}."
                )
            fail(msg)
        await verify_phone_code(code)
        ok(
            "Telegram sign-in complete. The agent can now call `make_call` "
            "to place the actual call (with `target` and `audio_path`)."
        )
        return

    if awaiting == "password":
        if not password:
            fail(
                "Telegram is awaiting the user's 2FA cloud password. Pass "
                "it as the `password` parameter to this tool."
            )
        await verify_2fa_password(password)
        ok(
            "2FA verification successful. The agent can now call "
            "`make_call` to place the actual call."
        )
        return

    fail(
        "No verification step is in progress. Start the auth flow by "
        "calling `make_call` with the user's `phone` first; this tool is "
        "only used afterwards to submit the verification code (or 2FA "
        "password) that Telegram requested."
    )


def amain_reset(input_data: dict) -> None:
    """Handler for the `reset_telegram_auth` tool. Wipes every auth artifact
    (auth_state.json, auth_complete marker, .session file & journal,
    expired-streak counter) so the next `make_call` performs a fresh DH key
    exchange. Synchronous — no Telegram round-trip needed."""
    summary = purge_session_files()
    _debug_log(f"reset_telegram_auth removed={summary['removed']}")
    removed = summary["removed"]
    not_present = summary["not_present"]
    location_note = (
        f"Auth files live at {SESSION_DIR}/. (Most filenames in this list "
        "are conditional — `auth_complete` only exists after a successful "
        "sign-in, `telegram-call.session-journal` only during a SQLite "
        "write, and `expired_streak.json` only after a PHONE_CODE_EXPIRED.) "
    )
    if not removed:
        ok(
            "Nothing to reset: no Telegram auth artifacts were present. "
            f"{location_note}You can proceed by calling `make_call` with "
            "the user's `phone` to start a fresh authentication."
        )
        return
    msg = f"Telegram auth state reset. Removed: {', '.join(removed)}. "
    if not_present:
        msg += f"(Already absent: {', '.join(not_present)}.) "
    msg += (
        location_note
        + "The next call to `make_call` with the user's `phone` will "
        "perform a fresh DH key exchange and issue a brand-new "
        "verification code."
    )
    ok(msg)


def main() -> None:
    tool_name = sys.argv[1] if len(sys.argv) > 1 else "unknown"

    try:
        raw = sys.stdin.read()
    except Exception as e:
        fail(f"Failed to read stdin: {e}")

    try:
        input_data = json.loads(raw) if raw.strip() else {}
    except json.JSONDecodeError as e:
        fail(f"Invalid JSON input: {e}")

    if tool_name == "synthesize_speech":
        try:
            synthesize_speech_tool(input_data)
        except SystemExit:
            raise
        except Exception as e:
            fail(f"TTS failed: {type(e).__name__}: {e}")
        return

    if tool_name == "make_call":
        os.makedirs(SESSION_DIR, exist_ok=True)
        try:
            asyncio.run(amain_make_call(input_data))
        except SystemExit:
            raise
        except Exception as e:
            fail(f"Telegram call failed: {type(e).__name__}: {e}")
        return

    if tool_name == "verify_telegram_code":
        os.makedirs(SESSION_DIR, exist_ok=True)
        try:
            asyncio.run(amain_verify(input_data))
        except SystemExit:
            raise
        except Exception as e:
            fail(f"Verification failed: {type(e).__name__}: {e}")
        return

    if tool_name == "reset_telegram_auth":
        try:
            amain_reset(input_data)
        except SystemExit:
            raise
        except Exception as e:
            fail(f"Reset failed: {type(e).__name__}: {e}")
        return

    fail(f"Unknown tool: {tool_name}")


if __name__ == "__main__":
    main()
